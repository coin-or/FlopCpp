@COIN_RELOCATABLE_FALSE@prefix=@prefix@
@COIN_RELOCATABLE_TRUE@prefix=${pcfiledir}/../..
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@/coin-or

Name: FlopC++
Description: An Algebraic Modeling Language in C++
URL: @PACKAGE_URL@
Version: @PACKAGE_VERSION@
Cflags: -I${includedir}
@COIN_STATIC_BUILD_FALSE@Libs: -L${libdir} -lFlopCpp
@COIN_STATIC_BUILD_FALSE@Requires.private: @FLOPCPPLIB_PCFILES@
@COIN_STATIC_BUILD_TRUE@Libs: -L${libdir} -lFlopCpp @FLOPCPPLIB_LFLAGS_NOPC@
@COIN_STATIC_BUILD_TRUE@Requires: @FLOPCPPLIB_PCFILES@
